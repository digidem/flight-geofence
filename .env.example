# Required. The application refuses to start with the example values.
ADMIN_PASSWORD=replace-with-a-long-unique-password
APP_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
ALLOW_INSECURE_DEFAULTS=false

# Bind to localhost by default. Put an authenticated HTTPS reverse proxy in front
# before changing BIND_ADDRESS to 0.0.0.0.
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
SESSION_HTTPS_ONLY=false
TRUSTED_HOSTS=localhost,127.0.0.1
# Optional public HTTPS profile. Point this domain at the server, set
# SESSION_HTTPS_ONLY=true and add the domain to TRUSTED_HOSTS while retaining
# localhost and 127.0.0.1 for container health checks, then run
# `docker compose --profile public up --build -d`.
DOMAIN=

# Optional. Canonical base URL for links in alert emails (e.g. https://geofence.example.com).
# When set, emails include a prominent "Open event" button linking to the authenticated event page.
DASHBOARD_BASE_URL=

# Optional. Blank values can be configured through the authenticated interface.
OPERATING_PHASE=
FLIGHT_PROVIDERS=
ALERT_RECIPIENTS=
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
FLIGHTRADAR24_API_KEY=
ADSBEXCHANGE_API_KEY=

# Flightradar24 Explorer-plan cluster monitoring. FLIGHTRADAR24_API_KEY above is
# the token for this too -- do not set a separate one. Blank values can be
# configured through the authenticated interface; setting any of these here
# permanently locks the matching admin control.
FR24_ENABLED=
FR24_PLAN=
FR24_PLAN_MONTHLY_CREDITS=
FR24_MONTHLY_OPERATING_BUDGET=
FR24_PROMOTIONAL_CREDITS=
FR24_BUDGET_POLICY=
FR24_POLL_INTERVAL_SECONDS=
FR24_INTER_CLUSTER_DELAY_SECONDS=
FR24_RESPONSE_LIMIT=
FR24_SUMMARY_VARIANT=
FR24_DEFAULT_CATEGORIES=
FR24_DEFAULT_MIN_ALTITUDE_FT=
FR24_DEFAULT_MAX_ALTITUDE_FT=
FR24_CLUSTER_BUFFER_KM=
FR24_FETCH_SUMMARY_ON_ENTRY=
FR24_FETCH_TRACK_ON_EVENT=
FR24_USAGE_SYNC_ENABLED=
# Defaults to false: FR24-derived data is retained indefinitely by design
# (see docs/SPEC.md "FR24 retention" for the governmental-authority basis).
# Only set this to true if that legal basis ever changes.
FR24_AUTO_DELETE_ENABLED=
# Structural cap, not admin-UI configurable.
FR24_MAX_ACTIVE_CLUSTERS=2

# Runtime and official boundary synchronization.
DATABASE_PATH=/data/runtime/flight_alerts.db
DOWNLOAD_DIR=/data/downloads
BOUNDARY_SYNC_ENABLED=true
BOUNDARY_SYNC_INTERVAL_DAYS=7
BOUNDARY_SYNC_CHECK_HOURS=6
TARGET_STATES=PA,AM,AP,RR
NEIGHBOR_DISTANCE_KM=10
AUTO_SELECT_ALL_ON_FIRST_SYNC=true
AUTO_SELECT_NEW_AREAS_WHEN_ALL_SELECTED=true
FUNAI_WFS_URL=https://geoserver.funai.gov.br/geoserver/Funai/ows
FUNAI_WFS_TYPENAME=Funai:tis_poligonais
FUNAI_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36
ICMBIO_WFS_URL=https://geoservicos.inde.gov.br/geoserver/ICMBio/ows
ICMBIO_WFS_TYPENAME=ICMBio:limiteucsfederais_a
RAISG_ANPS_URL=https://geo2.socioambiental.org/raisg/rest/services/raisg/raisg_anps_N/MapServer/2/query
MMA_CKAN_PACKAGE_URL=https://dados.mma.gov.br/api/3/action/package_show?id=44b6dc8a-dc82-4a84-8d95-1b0da7c85dac
CNUC_FALLBACK_URL=https://dados.mma.gov.br/dataset/44b6dc8a-dc82-4a84-8d95-1b0da7c85dac/resource/b1f7a269-a0b2-4a81-9ac5-108905e74a00/download/shp_cnuc_2026_03.zip
MAX_DOWNLOAD_MB=750
MAX_EXTRACTED_MB=2500
MAX_ZIP_MEMBERS=20000
# Safety checks prevent an unexpectedly partial upstream download from replacing
# a previously healthy official dataset.
BOUNDARY_MIN_TERRITORIES=20
BOUNDARY_MIN_CONSERVATION_UNITS=5

# Flight polling. UI values override defaults only when the matching env is blank.
POLL_INTERVAL_SECONDS=
QUERY_RADIUS_NM=200
QUERY_SPACING_FACTOR=1.0
MAX_QUERY_REGIONS=250
OBSERVATION_BUFFER_KM=25
API_REQUEST_DELAY_MS=750
POSITION_MAX_AGE_SECONDS=150
HTTP_TIMEOUT_SECONDS=40
SCHEDULER_INITIAL_DELAY_SECONDS=20
STATE_RETENTION_DAYS=14
# FR24 documentation limits storage; the app hard-caps this at 29 days.
FR24_RETENTION_DAYS=29
USER_AGENT=flight-geofence-poc/0.4 contact=luandro@gmail.com

# Alert defaults; configurable in the interface when blank.
MIN_INSIDE_OBSERVATIONS_FOR_STOP=
STOP_MIN_DURATION_SECONDS=
STATIONARY_RADIUS_METERS=
STOP_MAX_SPEED_KT=
MIN_INSIDE_OBSERVATIONS_FOR_DISAPPEARANCE=
DISAPPEAR_AFTER_SUCCESSFUL_POLLS=
DISAPPEAR_MAX_ALTITUDE_FT=
OUTSIDE_CONFIRMATION_OBSERVATIONS=
MAX_EMAILS_PER_DAY=

# Optional SMTP alternative.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=

# High-confidence scheduled-airline heuristic. Unknown aircraft remain candidates.
AIRLINE_CALLSIGN_PREFIXES=AZU,GLO,TAM,PTB,AEA,AFR,AVA,BAW,CMP,DAL,DLH,IBE,KLM,UAL
AIRLINER_TYPES=A20N,A319,A320,A321,A332,A333,A339,B737,B738,B739,B38M,B39M,B744,B748,B752,B763,B772,B77W,B788,B789,E190,E195,E290,E295,AT72
