# FR24 sandbox environment -- copy to .env.sandbox and fill in the sandbox key.
# NEVER copy values from the production .env: this file is the complete env of
# the sandbox stack (docker-compose.sandbox.yml replaces, not merges, env_file).
#
# The sandbox key is a SEPARATE key from the one in Key management at
# https://fr24api.flightradar24.com/key-management -- sandbox calls return
# static data and consume no credits.

# Required. Throwaway values -- this stack is local-only and disposable.
ADMIN_PASSWORD=replace-with-a-throwaway-password
APP_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
ALLOW_INSECURE_DEFAULTS=false
TRUSTED_HOSTS=localhost,127.0.0.1

# The sandbox key goes here (Bearer auth; same endpoints, static responses).
# Paste the bare key WITHOUT surrounding quotes -- a quoted key fails with
# 401 "Invalid API key" (the quotes become part of the Bearer token).
FLIGHTRADAR24_API_KEY=
# The FR24 kill switch defaults to false -- turn polling on explicitly.
FR24_ENABLED=true
# 300 is the lowest allowed interval; the first cycle runs ~5s after start.
FR24_POLL_INTERVAL_SECONDS=300

# --- Sandbox-data accommodations (do NOT use in production) ---
# Sandbox payloads carry static timestamps from 2024-10-10 (~2.2 years old);
# the default 150s freshness window would silently drop every observation.
# 70000000s ≈ 2.22 years.
POSITION_MAX_AGE_SECONDS=70000000
# cleanup_stale_states() purges aircraft state older than this many days
# against utc_now(); 2024-dated state needs a window of ~100 years.
STATE_RETENTION_DAYS=36500
# First poll cycle shortly after boot so smoke checks finish fast.
SCHEDULER_INITIAL_DELAY_SECONDS=5

# No boundary datasets needed -- the sandbox cluster uses manual bounds.
BOUNDARY_SYNC_ENABLED=false
DATABASE_PATH=/data/runtime/flight_alerts.db
DOWNLOAD_DIR=/data/downloads
